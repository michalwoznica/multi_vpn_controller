#!/usr/bin/env bash
# Multi VPN Controller — public modular entrypoint.
# Release identity is loaded from source/release-version.
# Legacy internal implementation identifiers are intentionally retained for this refactor.
set -euo pipefail
umask 077
export LC_ALL=C
MVC24E_CODE_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P) || exit 1
readonly MVC24E_CODE_ROOT
MVC24E_RELEASE_VERSION_FILE=$MVC24E_CODE_ROOT/release-version
[[ -f $MVC24E_RELEASE_VERSION_FILE && ! -L $MVC24E_RELEASE_VERSION_FILE ]] || {
    printf '%s\n' 'Multi VPN Controller: release-version file is missing or unsafe.' >&2
    exit 1
}
mapfile -t MVC24E_RELEASE_VERSION_LINES < "$MVC24E_RELEASE_VERSION_FILE" || exit 1
(( ${#MVC24E_RELEASE_VERSION_LINES[@]} == 1 )) || {
    printf '%s\n' 'Multi VPN Controller: release-version must contain exactly one line.' >&2
    exit 1
}
MVC24_RELEASE_VERSION=${MVC24E_RELEASE_VERSION_LINES[0]}
[[ $MVC24_RELEASE_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    printf '%s\n' 'Multi VPN Controller: release-version is invalid.' >&2
    exit 1
}
readonly MVC24_RELEASE_VERSION
unset MVC24E_RELEASE_VERSION_LINES MVC24E_RELEASE_VERSION_FILE
# shellcheck source=../lib/combined-controller-wiring.sh
source "$MVC24E_CODE_ROOT/lib/combined-controller-wiring.sh" || exit 1
mvc24e_dispatch "$@"
